{
  "version": 2,
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:client",
  "outputDirectory": "dist/public",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/api/trpc-handler?__trpc_path=:path*"
    },
    {
      "source": "/api/trpc",
      "destination": "/api/trpc-handler?__trpc_path="
    }
  ]
}
